{
  "name": "@ice9/sdk",
  "version": "0.0.8",
  "description": "Node.js SDK for the ice9 image analysis API",
  "license": "MIT",
  "homepage": "https://ice9.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice9innovations/ice9-sdk.git",
    "directory": "nodejs"
  },
  "bugs": {
    "url": "https://github.com/ice9innovations/ice9-sdk/issues"
  },
  "keywords": [
    "ice9",
    "image-analysis",
    "computer-vision",
    "ai",
    "nsfw",
    "content-moderation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
